{
  "family": "ecommerce-dev-task-2",
  "executionRoleArn": "arn:aws:iam::125273094628:role/ecsTaskExecutionRole",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "512",
  "memory": "1024",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "containerDefinitions": [
    {
      "name": "ecommerce-api",
      "image": "PLACEHOLDER",
      "cpu": 512,
      "memory": 1024,
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp",
          "name": "ecommerce-api-8080-tcp",
          "appProtocol": "http"
        }
      ],
      "environment": [
        {
          "name": "DB_HOST",
          "value": "ecommerce-dev.c8z84m2smy2u.us-east-1.rds.amazonaws.com"
        },
        {
          "name": "DB_PORT",
          "value": "3306"
        },
        {
          "name": "DB_NAME",
          "value": "ecommerce"
        }
      ],
      "secrets": [
        {
          "name": "DB_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:125273094628:secret:rds!db-6368f580-8784-49e9-bb76-fc6e7b85d53c-CwLpPE"
        },
        {
          "name": "DB_USERNAME",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:125273094628:secret:rds!db-6368f580-8784-49e9-bb76-fc6e7b85d53c-CwLpPE"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/ecommerce-dev-task",
          "awslogs-create-group": "true",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}